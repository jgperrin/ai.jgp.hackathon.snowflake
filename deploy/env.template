# Template for /opt/contextbuilder/.env on the api VM.
#
# The real file is NOT in this repo and must never be. Copy this up, fill it in
# on the VM, and keep it jgp:jgp mode 0600 — the service reads it and nothing
# else should.
#
#   scp deploy/env.template api:/tmp/ctx.env
#   ssh api 'sudo install -o jgp -g jgp -m 600 /tmp/ctx.env /opt/contextbuilder/.env && rm /tmp/ctx.env'
#
# It is read twice over: systemd's EnvironmentFile= for the process environment,
# and Spring via `spring.config.import=optional:file:.env[.properties]` (the
# unit's WorkingDirectory is this same directory). Hence KEY=value throughout —
# no `export`, no shell expansion, no command substitution, no quoting.

# --- Bind ---------------------------------------------------------------------
# Loopback ONLY, and not optional in spirit even though Spring has a default.
# Spring Boot binds 0.0.0.0 unless told otherwise, which would publish :8093 on
# 10.0.2.101 where any peer on 10.0.2.0/24 could reach it directly — bypassing
# nginx, its basic auth and its path structure. nginx is the only intended way in.
SERVER_ADDRESS=127.0.0.1

# 8080 is Bitol svc, 8083 bitol-mcp, 8086/8087 next, 8088 controlcenter,
# 8089 schema-drift-advisor, 8090 dpcompare, 8091/8092 crm. See
# ~/GitHub/ops/infra/api-vm/README.md for the full table before changing this.
SERVER_PORT=8093

# --- Snowflake ------------------------------------------------------------------
# The bare account identifier, NOT a URL — the app appends
# .snowflakecomputing.com itself. Either form works:
#   myorg-myaccount        (organisation-qualified)
#   xy12345.us-east-1      (locator plus region)
SNOWFLAKE_ACCOUNT=

SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

# Optional — each is appended to the JDBC URL only when non-blank, so leaving
# them empty means the account's defaults apply.
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_ROLE=

# --- Cortex ---------------------------------------------------------------------
# Sent explicitly on every call: Cortex has no documented server-side default.
# Check what this region actually offers with: SHOW CORTEX BASE MODELS;
CORTEX_MODEL=claude-sonnet-5
